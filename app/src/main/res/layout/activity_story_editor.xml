<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Header: Self | Hawkeye style -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="?attr/colorSurface">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSelectedChar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Self"
            app:chipMinHeight="32dp" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/tvRecipient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:alpha="0.5"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Character chips row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/characterChipsGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <!-- Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <!-- Input row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:gravity="center_vertical"
        android:background="?attr/colorSurface">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/message_hint"
            android:imeOptions="actionSend"
            android:maxLines="4"
            android:inputType="textMultiLine|textCapSentences" />

        <ImageButton
            android:id="@+id/btnComment"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_comment"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Add comment"
            android:layout_marginStart="4dp" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_send"
            android:background="@drawable/bg_send_button"
            android:layout_marginStart="4dp"
            android:contentDescription="Send" />
    </LinearLayout>

    <!-- Bottom bar: My stories | Edit names | Edit story | Settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:id="@+id/btnClearStory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_list" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/my_stories" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnEditNames"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_people" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/edit_names" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_edit" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/edit_story" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:id="@+id/btnSettingsNav">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_settings" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/settings" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Create Video button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreateVideo"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/create_video"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        app:cornerRadius="28dp"
        app:icon="@drawable/ic_play" />

</LinearLayout>
